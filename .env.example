# Copy this file to `.env` and fill in the keys you have.
# A provider without a key is skipped automatically: the app keeps working with
# whatever remains and tells you which keys are missing.

# NewsAPI.org - free developer key: https://newsapi.org/register
# Browser requests are proxied through /proxy/newsapi to avoid CORS.
VITE_NEWS_API_KEY=

# The Guardian Open Platform - request a developer key:
# https://open-platform.theguardian.com/access/
VITE_GUARDIAN_API_KEY=

# New York Times Article Search - create an app and enable "Article Search":
# https://developer.nytimes.com/get-started
# Free tier allows 5 requests/minute and 500 requests/day.
VITE_NYT_API_KEY=
